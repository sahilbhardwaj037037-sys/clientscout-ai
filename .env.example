# Optional root .env. Restart both servers after changing shared ports.
# Empty values use config/local.json defaults (API 8000, frontend 5173).
CLIENTSCOUT_API_PORT=
CLIENTSCOUT_FRONTEND_PORT=
# Default: backend/data/clientscout.db; relative paths resolve from repo root.
CLIENTSCOUT_DB_PATH=
# Backend-only optional PageSpeed. Empty enabled flag uses key presence.
# Set PAGESPEED_ENABLED=true for explicitly requested keyless calls, or false to disable.
# Daily limit defaults to 10 attempted calls per rolling 24 hours (valid range 1..100).
PAGESPEED_ENABLED=
PAGESPEED_DAILY_LIMIT=
PAGESPEED_API_KEY=
# Backend-only optional Gemini assistance. Missing key disables external AI calls.
GEMINI_API_KEY=
# Explicit model; no automatic model switch. Default gemini-3.5-flash-lite (required for AI Writer).
GEMINI_MODEL=
# Local rolling 24-hour attempted/reserved request budget (1..100; default 10).
GEMINI_DAILY_LIMIT=
# Backend-only discovery. Empty flag defaults true; false disables new searches.
# Default endpoint: https://overpass-api.de/api/interpreter (shared, no SLA).
# An override must be public HTTPS without credentials, query strings or fragments.
DISCOVERY_ENABLED=
OVERPASS_API_URL=
